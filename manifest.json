{
  "manifest_version": 3,
  "name": "Axiom Vim",
  "version": "0.3.5",
  "description": "Vim-style keyboard shortcuts for axiom.trade: navigate, open and hide Pulse coins; holders, X preview, chart zoom and more on trade pages.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Axiom Vim",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.axiom.trade/*"],
      "js": ["shared.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
